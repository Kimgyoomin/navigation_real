<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="visualize" default="true"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <!-- =========================================================
       GenZ odometry:
         camera_init -> velodyne
       ========================================================= -->
  <node pkg="genz_icp" type="odometry_node" name="genz_odometry" output="screen">
    <!-- ROS wrapper params -->
    <rosparam file="$(find genz_icp)/config/genz_velodyne_odometry.yaml"
              command="load"/>

    <!-- GenZ-ICP core params -->
    <rosparam file="$(find genz_icp)/config/localization_corridor.yaml"
              command="load"/>
  </node>

  <!-- =========================================================
       GenZ scan-to-map localization:
         map -> camera_init
       ========================================================= -->
  <node pkg="genz_icp" type="localization_node" name="genz_localization" output="screen">
    <!-- ROS wrapper params -->
    <rosparam file="$(find genz_icp)/config/genz_velodyne_localization.yaml"
              command="load"/>

    <!-- GenZ-ICP core params -->
    <rosparam file="$(find genz_icp)/config/localization_corridor.yaml"
              command="load"/>
  </node>
  
  <!-- Visualizer -->
  <group if="$(arg visualize)">
    <node pkg="rviz" type="rviz" name="rviz"
            args="-d $(find genz_icp)/rviz/genz_icp_ros1.rviz"/>
  </group>    
</launch>