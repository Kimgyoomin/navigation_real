  <library_effects>
    <effect id="Concrete_Smooth-effect">
      <profile_COMMON>
        <newparam sid="Concrete_Smooth_jpg-surface">
          <surface type="2D">
            <init_from>Concrete_Smooth_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="Concrete_Smooth_jpg-sampler">
          <sampler2D>
            <source>Concrete_Smooth_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Concrete_Smooth_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
