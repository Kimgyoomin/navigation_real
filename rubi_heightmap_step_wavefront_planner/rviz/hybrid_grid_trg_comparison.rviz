Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: PGM Map
      Alpha: 0.7
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Global Costmap
      Alpha: 0.55
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FastDEM Height Cloud
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fastdem/mapping/cloud_global
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot Model
      Description Topic: /robot_description
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Grid Expanded Cells
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/grid/expanded_cells
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Grid Search Edges
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/grid/search_edges
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Grid Path
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.08
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/grid/path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Grid Tracking Path
      Color: 0; 255; 80
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/grid/tracking_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Sampling Nodes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/sampling/nodes
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Sampling Edges
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/sampling/edges
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Sampling Rejected
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/sampling/rejected
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Sampling Path
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.08
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/sampling/path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Sampling Tracking Path
      Color: 255; 210; 0
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/sampling/tracking_path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Robot Trace
      Color: 255; 140; 0
      Line Style: Lines
      Line Width: 0.06
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rubi/planner_comparison/robot_trace
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 28
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /rubi/planner_comparison/goal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Name: Current View
      Pitch: 0.8
      Target Frame: map
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1500
