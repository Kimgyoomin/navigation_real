<launch>
  <arg name="rviz" default="true" />

    <rosparam command="load" file="$(find fast_lio_localization)/config/velodyne.yaml" />

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="4"/>
    <param name="max_iteration" type="int" value="3" />
    <param name="filter_size_surf" type="double" value="0.5" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="0" />
    <param name="pcd_save_enable" type="bool" value="0" />
    <node pkg="fast_lio_localization" type="fastlio_mapping" name="laserMapping" output="screen" />

    <arg name="map" default="/home/rclab/catkin_nav_ws/src/FAST_LIO/PCD/scans_down.pcd" />
    <node pkg="fast_lio_localization" type="global_localization.py" name="global_localization" output="screen" launch-prefix="python3" />

    <node pkg="fast_lio_localization" type="transform_fusion.py" name="transform_fusion" output="screen" launch-prefix="python3" />

    <!-- <node pkg="pcl_ros" type="pcd_to_pointcloud" name="map_publishe" output="screen"
          args="$(arg map) 5 _frame_id:=/map cloud_pcd:=/map" /> -->
    <node pkg="pcl_ros" type="pcd_to_pointcloud" name="map_publishe" output="screen"
          args="$(arg map) 5 _frame_id:=map cloud_pcd:=/laser_map" />

    <arg name="map_2d" default="/home/rclab/catkin_nav_ws/src/FAST_LIO_LOCALIZATION/map/building_1f_map.yaml"/>
    <!-- <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_2d)">
      <param name="frame_id" value="map"/>
      <remap from="map" to="map_2d"/>
    </node> -->

    <!-- 20260114 pongbot global navigation을 위해 끔 -->
    <!-- <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_2d)">
      <param name="frame_id" value="map_2d"/> 
      <remap from="map" to="map_2d" />
    </node> -->
    
    <!-- 20260114 pongbot global navigation을 위해 끔 -->
    <!-- <node pkg="tf" type="static_transform_publisher" name="map_2d_to_3d_alignment" 
          args="0.5 0.45 -0.1 -0.02 0 0 map map_2d 100" /> -->

    <group if="$(arg rviz)">
      <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio_localization)/rviz_cfg/global_nav_localization.rviz" />
    </group>

</launch>