#!/usr/bin/python3
"""Run an explicitly supplied command with a process-local DDS transport profile."""
import argparse
import os
import sys

from navigation_dds.profiles import PROFILE_MIB, UDP_BUFFER_MIB, profile_environment


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('profile', choices=PROFILE_MIB)
    parser.add_argument('command', nargs=argparse.REMAINDER,
                        help='e.g. ros2 bag record -o /path/to/new_bag /livox/imu ...')
    args = parser.parse_args()
    command = args.command
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        parser.error('a command is required')
    environment = dict(os.environ)
    try:
        environment.update(profile_environment(args.profile, environment))
    except (ValueError, RuntimeError) as exc:
        parser.error(str(exc))
    print(f'DDS profile: {PROFILE_MIB[args.profile]} MiB SHM + UDP (child command); '
          f'DDS UDP buffer requests: TX/RX {UDP_BUFFER_MIB} MiB each (kernel caps apply)',
          file=sys.stderr, flush=True)
    os.execvpe(command[0], command, environment)


if __name__ == '__main__':
    main()
